# RPC endpoint, passed to forge as --rpc-url $ETH_RPC_URL.
ETH_RPC_URL=

# Deployer key, read by every script in script/. Must be 0x-prefixed hex.
PRIVATE_KEY=

# GPv2Settlement, for ComposableCow's constructor.
# Read by deploy_ComposableCow and deploy_ProdStack.
SETTLEMENT=0x9008D19f58AAbD9eD0D60971565AA8510560ab41

# Deployed ComposableCow, read by deploy_OrderTypes and submit_SingleOrder.
# COMPOSABLE_COW=

# Read by submit_SingleOrder: the Safe placing the order, and the TWAP handler.
# SAFE=
# TWAP=

# Owner of the rotatable handlers, read by deploy_GnosisStack.
# ADMIN=

# Read by dev/verify-contracts.sh, and by forge script --verify.
# ETHERSCAN_API_KEY=
